#!/bin/bash
set -eux
export DEBIAN_FRONTEND=noninteractive
apt-get update -y
apt-get install -y python3-pip python3-venv

mkdir -p /app/templates
echo '${app_b64}' | base64 -d > /app/app.py
echo '${business_b64}' | base64 -d > /app/business.py
echo '${requirements_b64}' | base64 -d > /app/requirements.txt
echo '${template_b64}' | base64 -d > /app/templates/index.html

cd /app
python3 -m venv venv
venv/bin/pip install -r requirements.txt

cat >/etc/systemd/system/flask-backend.service <<'SERVICE'
[Unit]
Description=Flask Backend
After=network.target
[Service]
WorkingDirectory=/app
ExecStart=/app/venv/bin/python app.py
Restart=always
[Install]
WantedBy=multi-user.target
SERVICE

systemctl daemon-reload
systemctl enable --now flask-backend.service
