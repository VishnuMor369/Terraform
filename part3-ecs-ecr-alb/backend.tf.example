# Rename/copy this file to backend.tf after creating an S3 bucket for Terraform state.
# Example bucket: terraform-vishnu-state-<unique-suffix>
terraform {
  backend "s3" {
    bucket         = "REPLACE_WITH_YOUR_STATE_BUCKET"
    key            = "terraform-assignment/terraform.tfstate"
    region         = "us-east-1"
    encrypt        = true
  }
}
