{
  "family": "vishnu-frontend-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "REPLACE_WITH_ACTUAL_ECS_TASK_EXECUTION_ROLE_ARN",
  "containerDefinitions": [
    {
      "name": "vishnu-frontend",
      "image": "710882444873.dkr.ecr.us-east-1.amazonaws.com/vishnu-frontend:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 3000,
          "hostPort": 3000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "BACKEND_URL",
          "value": "http://REPLACE_WITH_ALB_DNS_NAME/api"
        }
      ]
    }
  ]
}